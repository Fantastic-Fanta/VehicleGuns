{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [{ "adapter": "kotlin", "value": "dev.vehicleguns.fabric.VehicleGunsFabric" }],
    "client": [{ "adapter": "kotlin", "value": "dev.vehicleguns.fabric.VehicleGunsFabricClient" }]
  },
  "mixins": ["vehicleguns.mixins.json"],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.0"
  }
}
